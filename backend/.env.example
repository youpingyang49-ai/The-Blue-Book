PORT=8080
DATABASE_URL=bluebook:bluebook@tcp(127.0.0.1:3306)/bluebook?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379
JWT_SECRET=the-blue-book-dev-secret-change-me
# Access / Refresh Token 有效期（Go duration 格式）
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
APP_ENV=development
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 对象存储：MINIO_ENDPOINT 留空用本地磁盘；设置后切换到 MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bluebook
MINIO_USE_SSL=false

# 消息队列（RabbitMQ）
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
